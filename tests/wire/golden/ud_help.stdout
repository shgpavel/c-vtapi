url_dist < --apikey YOUR_API_KEY >  [ --all-info ] [ --sleep X ] [ --repeat X ]
  --apikey YOUR_API_KEY   Your virus total API key.  This arg 1st 
  --all-info              When doing a report, set allinfo flag
  --before                before timestamp
  --after                before timestamp
  --limit                limit results
  --repeat               Repeat X times updating the feeed
  --sleep                Sleep X seconds between requests
